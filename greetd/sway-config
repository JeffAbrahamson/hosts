# greetd doesn't set XDG_CURRENT_DESKTOP from the session's DesktopNames
# as other display managers do, and sway doesn't set it either.
exec "/usr/sbin/wlgreet --command 'env XDG_CURRENT_DESKTOP=sway XDG_SESSION_DESKTOP=sway ssh-agent sway'; swaymsg exit"

# Ctrl+Shift+Q, then y (power off), r (reboot), or n/Esc/Ctrl+G (cancel).
# There's no bar, so the mode gives no visual feedback.  Plain systemctl:
# -i needs admin auth in polkit, which _greetd can't provide.  This works
# even when a logged-out session lingers only because of
# greetd-power.rules (installed by install.sh).
set $shutdown_mode "Shutdown?"

bindsym Control+Shift+Q mode "$shutdown_mode"
mode "$shutdown_mode" {
    bindsym y          exec systemctl poweroff
    bindsym r          exec systemctl reboot
    bindsym Control+g  mode default
    bindsym n          mode default
    bindsym Escape     mode default
}

output * bg /etc/greetd/background fill

